# syntax=docker/dockerfile:1
#
# Video-Claw frontend image.
# Multi-stage build: deps -> build (standalone) -> slim runner.
#
# Build context is the repository root (/root/projects/VideoClaw/), so source
# paths are prefixed with video-claw/video-claw/frontend/.
#
# Build with ./build-frontend.sh — it reads BACKEND_PORT from the repo-root
# .env and passes it as the build arg below. Building WITHOUT that arg now fails
# on purpose (see the builder-stage assertion): do not reintroduce a default.
#
FROM node:22-alpine AS deps
WORKDIR /app
COPY video-claw/video-claw/frontend/package.json video-claw/video-claw/frontend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
# Backend port MUST be supplied at BUILD time (./build-frontend.sh reads it from
# the repo-root .env). Both derived values are BAKED into the build output and
# must match the backend's real port, otherwise:
#   BACKEND_INTERNAL_URL      -> server-side rewrites proxy to a dead port;
#                                every /api/* through the frontend returns 500
#   NEXT_PUBLIC_BACKEND_PORT  -> browser SSE fallback baked into client chunks
#                                with the wrong port
# Runtime env does NOT change either — rebuild after editing .env.
# Deliberately no default: an empty value would bake `http://backend:` and fail
# silently, so assert instead. Kept before the COPY layers so a bad invocation
# fails instantly; `--target deps` (used to grab node_modules offline) is
# unaffected because this stage is skipped entirely.
ARG BACKEND_PORT=
RUN if [ -z "${BACKEND_PORT}" ]; then echo "ERROR: BACKEND_PORT is required. Build the frontend image with ./build-frontend.sh, or pass --build-arg BACKEND_PORT=<port>. See docs/handoffs/Handoff 5." >&2; exit 1; fi
COPY --from=deps /app/node_modules ./node_modules
COPY video-claw/video-claw/frontend/ ./
ENV BACKEND_INTERNAL_URL=http://backend:${BACKEND_PORT} \
    NEXT_PUBLIC_BACKEND_PORT=${BACKEND_PORT}
# Build the standalone output (requires `output: "standalone"` in next.config.ts).
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Run as a non-root user.
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# The standalone server is self-contained; we still need static assets & public.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
CMD ["node", "server.js"]
