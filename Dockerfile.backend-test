# 后端测试镜像：只在既有生产镜像之上追加测试依赖，不复制源码。
#
# 构建（与 Dockerfile.backend 一样在 compose 之外执行，compose 仍只负责运行镜像；
# 只在生产镜像或测试依赖版本变化时才需要重建，日常跑测试不触发构建）：
#   mkdir -p /tmp/vc-test-ctx
#   docker build --pull=false -f Dockerfile.backend-test \
#     -t video-claw-backend-test:latest /tmp/vc-test-ctx
#
# 运行（需 video-claw-backend 容器在运行，用于复用它的 bind mount 与网络；
# 不新建第二套 DB / 对象存储，测试库与测试桶由 tests/conftest.py 隔离）：
#   ROOT=/home/wmd/projects/VideoClaw
#   docker inspect video-claw-backend --format '{{range .Config.Env}}{{println .}}{{end}}' > /tmp/vc-test-env
#   docker run --rm --network container:video-claw-backend \
#     --volumes-from video-claw-backend \
#     -v "$ROOT/video-claw/video-claw/backend/tests:/app/tests:ro" \
#     --env-file /tmp/vc-test-env -w /app \
#     video-claw-backend-test:latest \
#     uv run --no-sync python -m pytest -q
#   注意：必须用 `python -m pytest`；`uv run pytest` 不会把 /app 加进 sys.path，
#   会导致 conftest 报 ModuleNotFoundError: No module named 'api'。
#
FROM video-claw-backend:latest

# 项目运行时依赖由 uv 管理在 /app/.venv（pyvenv.cfg 关闭了 system-site-packages），
# 测试依赖必须装进同一个 venv；装到系统 Python 会被 `uv run` 忽略。
# 版本与 pyproject.toml 的 dev 可选依赖组对齐，但不修改任何依赖文件：
#   dev = ["pytest>=8.0.0", "pytest-asyncio>=0.23.0", "ruff>=0.6.0"]
# ruff 属静态检查、非运行测试所需，不预装。
RUN uv pip install --python /app/.venv/bin/python --no-cache \
      "pytest==9.2.0" "pytest-asyncio==1.5.0"

# 测试容器直接执行任意命令（uv run python -m pytest），不跑 docker-entrypoint.sh 的服务启动流程。
ENTRYPOINT []
WORKDIR /app
