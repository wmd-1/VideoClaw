# 复制为 .env 后生效：cp .env.example .env
#
# 作用范围：
#   1) 顶部端口变量由 docker compose 用于变量替换；
#   2) VC_* 变量作为后端配置覆盖层注入（优先级：进程环境变量 > .env 文件 > config.yaml > 默认值），
#      docker 部署经 compose env_file 注入容器；宿主机直跑后端时会读取仓库根与 backend/ 下的 .env。
# 生效方式：修改 .env 后执行 `docker compose up -d backend`（重建容器）或重启后端进程。
# 注意：被 VC_* 覆盖的字段在设置页只读展示并标注「来自 .env」，保存设置不会写回覆盖值。

# ────────────────────────────────
# 端口（docker compose 变量替换）
# ────────────────────────────────
# Port exposed on the HOST for the Next.js frontend (default 3000)
FRONTEND_PORT=3500

# Port exposed on the HOST for the FastAPI backend (default 8000)
BACKEND_PORT=8500

# 说明：本地直跑后端时，server.host/server.port 会自动对齐本文件的 BACKEND_HOST/BACKEND_PORT；
# Docker 部署时容器内监听端口与宿主发布端口一致（均为本文件的 BACKEND_PORT），日志所见即所得。
# 前端浏览器直连（SSE）与 SSR 代理目标的端口在构建期固化（见 README 构建命令），
# 需与本文件的 BACKEND_PORT 保持一致。

# ────────────────────────────────
# API Server / Common（设置页已不展示，统一在此配置）
# 命名：VC_SERVER__<字段> / VC_COMMON__<字段>（双下划线分隔层级）
#   VC_SERVER__HOST / VC_SERVER__PORT / VC_SERVER__LOG_LEVEL / VC_SERVER__ACCESS_LOG
#   VC_COMMON__PROXY / VC_COMMON__PRINT_MODEL_INPUT
# ────────────────────────────────
# VC_SERVER__LOG_LEVEL=INFO
# VC_SERVER__ACCESS_LOG=false
# VC_COMMON__PROXY=http://127.0.0.1:7890

# ────────────────────────────────
# 生成超时（视频/图像生成等待上限，单位秒；默认 3 小时 = 10800）
#   VC_TIMEOUT_IMAGE：图片生成（自定义图像客户端读取超时）
#   VC_TIMEOUT_VIDEO：视频生成 HTTP 超时 + 轮询等待上限（自定义视频客户端）
#   连接阶段仍保持 15s 快速失败（地址不可达不会长时间阻塞）
# ────────────────────────────────
# VC_TIMEOUT_IMAGE=10800
# VC_TIMEOUT_VIDEO=10800

# ────────────────────────────────
# 自定义供应商（api_providers）覆盖 / 新增
# 命名：VC_PROVIDER_<供应商名>__<字段>
#   <供应商名>：大写；既有的中划线键（如 omni-8091）用下划线形式 OMNI_8091 覆盖
#   字段：PROTOCOL（openai | vllm-omni | sglang）、BASE_URL、API_KEY、ENABLE_PROXY
# ────────────────────────────────
# 覆盖内置供应商（示例：DashScope / OpenAI 的 Key）
# VC_PROVIDER_DASHSCOPE__API_KEY=
# VC_PROVIDER_OPENAI__API_KEY=
# VC_PROVIDER_OPENAI__BASE_URL=https://api.openai.com/v1

# 新增 vllm 供应商（OpenAI 标准接口；LLM 与 VLM 可共用同一个供应商）
# VC_PROVIDER_LOCAL_LLM__PROTOCOL=openai
# VC_PROVIDER_LOCAL_LLM__BASE_URL=http://192.168.1.10:8000/v1
# VC_PROVIDER_LOCAL_LLM__API_KEY=
# VC_PROVIDER_LOCAL_VLM__PROTOCOL=openai
# VC_PROVIDER_LOCAL_VLM__BASE_URL=http://192.168.1.10:8000/v1

# 新增 vllm-omni 供应商（图像）
# VC_PROVIDER_LOCAL_IMAGE_T2I__PROTOCOL=vllm-omni
# VC_PROVIDER_LOCAL_IMAGE_T2I__BASE_URL=http://192.168.1.10:8091/v1
# VC_PROVIDER_LOCAL_IMAGE_IT2I__PROTOCOL=vllm-omni
# VC_PROVIDER_LOCAL_IMAGE_IT2I__BASE_URL=http://192.168.1.10:8091/v1

# 新增 sglang 供应商（视频/图像/对话）
# VC_PROVIDER_LOCAL_VIDEO_SGLANG__PROTOCOL=sglang
# VC_PROVIDER_LOCAL_VIDEO_SGLANG__BASE_URL=http://192.168.1.10:30010/v1

# 新增 vllm-omni 供应商（视频；与 sglang 版本分别登记，按部署选择）
# VC_PROVIDER_LOCAL_VIDEO_VLLM__PROTOCOL=vllm-omni
# VC_PROVIDER_LOCAL_VIDEO_VLLM__BASE_URL=http://192.168.1.10:8002/v1

# 注意：后端在 Docker 中运行时，容器内的 127.0.0.1/localhost 指向容器自身，
# 本地推理服务请填宿主机局域网 IP（如上面的 192.168.x.x）或 host.docker.internal。

# ────────────────────────────────
# 默认模型（models）覆盖
# 命名：VC_MODEL_<KEY>
#   KEY：LLM | VLM | IMAGE_T2I | IMAGE_IT2I | VIDEO_FIRST_FRAME | VIDEO_START_END | VIDEO_REFERENCE
# ────────────────────────────────
# VC_MODEL_LLM=local-llm
# VC_MODEL_VLM=local-vlm
# VC_MODEL_IMAGE_T2I=local-image-t2i
# VC_MODEL_IMAGE_IT2I=local-image-it2i
# VC_MODEL_VIDEO_FIRST_FRAME=local-video

# ────────────────────────────────
# 自定义模型（custom_models）注册
# 命名：VC_CUSTOM_MODEL_<序号>__<字段>（序号任意，如 1、2、...）
#   字段：ID（必填，唯一；即模型在列表中的展示名）、PROVIDER（必填，引用 api_providers 中的供应商）、
#         MODEL（下发模型名，可空=ID）、TYPES（llm,vlm,t2i,i2i,video 逗号分隔）、
#         ABILITIES（能力标签逗号分隔，如 text_to_video,first_frame_i2v；可留空按类型推导）、
#         CONCURRENCY（并发，缺省 1，本地单卡服务建议保持 1）
# 与 config.yaml 中同 id 的条目逐字段合并（.env 优先），新 id 追加。
# ────────────────────────────────
# VC_CUSTOM_MODEL_1__ID=local-llm
# VC_CUSTOM_MODEL_1__PROVIDER=local_llm
# VC_CUSTOM_MODEL_1__MODEL=Qwen3-32B
# VC_CUSTOM_MODEL_1__TYPES=llm
# VC_CUSTOM_MODEL_1__CONCURRENCY=1

# VC_CUSTOM_MODEL_2__ID=local-vlm
# VC_CUSTOM_MODEL_2__PROVIDER=local_vlm
# VC_CUSTOM_MODEL_2__MODEL=Qwen3-VL-32B
# VC_CUSTOM_MODEL_2__TYPES=vlm

# VC_CUSTOM_MODEL_3__ID=local-image-t2i
# VC_CUSTOM_MODEL_3__PROVIDER=local_image_t2i
# VC_CUSTOM_MODEL_3__TYPES=t2i

# VC_CUSTOM_MODEL_4__ID=local-image-it2i
# VC_CUSTOM_MODEL_4__PROVIDER=local_image_it2i
# VC_CUSTOM_MODEL_4__TYPES=i2i

# VC_CUSTOM_MODEL_5__ID=local-video
# VC_CUSTOM_MODEL_5__PROVIDER=local_video_sglang
# VC_CUSTOM_MODEL_5__TYPES=video
# VC_CUSTOM_MODEL_5__ABILITIES=text_to_video,first_frame_i2v,start_end_frame_i2v,reference_to_video

# VC_CUSTOM_MODEL_6__ID=local-video-vllm
# VC_CUSTOM_MODEL_6__PROVIDER=local_video_vllm
# VC_CUSTOM_MODEL_6__TYPES=video
# VC_CUSTOM_MODEL_6__ABILITIES=text_to_video,first_frame_i2v,start_end_frame_i2v,reference_to_video
# 说明：capabilities（分辨率/比例/时长等高级参数）暂不支持 env 覆盖，可在 config.yaml 中配置。

# ────────────────────────────────
# 提示词改写服务（Design Agent Platform）覆盖
# 命名：VC_DESIGN_AGENT__<字段>（双下划线分隔层级）
#   ENABLE（true/false，默认 false：禁用时主流程保持原六阶段，阶段不出现在流程/导航中）
#   BASE_URL（如 http://192.168.1.20:8001，自动拼接 /design_agent 前缀）
#   API_KEY（预留）、LOGIN_NAME（外部平台身份头 X-User-Login-Name 取值）
# ────────────────────────────────
# VC_DESIGN_AGENT__ENABLE=false
# VC_DESIGN_AGENT__BASE_URL=http://192.168.1.20:8001
# VC_DESIGN_AGENT__LOGIN_NAME=videoclaw